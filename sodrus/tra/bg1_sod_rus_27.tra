@14105 = ~Уничтожение оружия~
@14106 = ~Экипировка оружия~
@14107 = ~Просвечивание~
@14108 = ~Определение мировоззрения~
@14109 = ~Невидимость развеяна~
@14110 = ~Обзор области~
@14111 = ~Просмотр созданий~
@14112 = ~Зеркальный образ~
@14113 = ~Иммунитет к оружию~
@14114 = ~Анимационный эффект~
@14115 = ~Создание предмета~
@14116 = ~Уничтожение предмета~
