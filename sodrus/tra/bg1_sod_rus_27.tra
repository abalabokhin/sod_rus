@25334 = ~Истребитель нежити~
@25335 = ~Лучник~
@25336 = ~Сталкер~
@25337 = ~Хозяин зверей~
@25338 = ~Ассасин~
@25339 = ~Охотник за головами~
@25340 = ~Головорез~
