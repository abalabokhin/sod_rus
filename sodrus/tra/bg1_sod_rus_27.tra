@51988 = ~Да здравствует Лолт! Лишь ей мы обязаны всем своим победам!~ [DRPRIS01]
@51989 = ~Никогда не теряй бдительность, знай свое место, и тогда богиня, возможно, дарует тебе долгую жизнь!~ [DRPRIS02]
@51990 = ~Если Королева Ям Демонической Паутины потребует твое сердце, тебе стоит только возрадоваться этому!~ [DRPRIS03]
@51991 = ~Во славу Темной Матери!~ [DRPRIS04]
@51992 = ~~ [DRPRIS05]
@51993 = ~~ [DRPRIS06]
@51994 = ~Никто не избежит гнева Темной Матери!~ [DRPRIS07]
@51995 = ~Делай, как велят матроны, и будешь жить.~ [DRFEM101]
@51996 = ~Хвала Лолт.~ [DRFEM102]
@51997 = ~Предназначение дроу - покорить всех.~ [DRFEM103]
@51998 = ~Не отбрасывай на меня свою тень! Я многого добилась, и с тобой это никак тебя не связано.~ [DRFEM104]
@51999 = ~~ [DRFEM105]
@52000 = ~~ [DRFEM106]
@52001 = ~Поглоти тебя тьма! Вражина!~ [DRFEM107]
@52002 = ~Не задавай вопросов матронам-матерям.~ [DRMEN101]
@52003 = ~Для мужчины путь к превосходству лежит либо через постель, либо через магическое искусство.~ [DRMEN102]
@52004 = ~Отстраниться от своего Дома и Королевы, значит отправиться прямиком в могилу.~ [DRMEN103]
@52005 = ~К твоим услугам!~ [DRMEN104]
@52006 = ~~ [DRMEN105]
@52007 = ~~ [DRMEN106]
@52008 = ~Дроу будут править миром!~ [DRMEN107]
@52009 = ~Я из поверженного Дома, и поэтому моя жизнь ничего не стоит.~ [DRSLV101]
@52010 = ~Все могло бы быть иначе... увы, я навлек на себя гнев Темной Матери.~ [DRSLV102]
@52011 = ~Все... все могло было быть куда хуже. Меня могли бы сделать... драйдером.~ [DRSLV103]
@52012 = ~Я... я здесь, чтобы служить.~ [DRSLV104]
@52013 = ~~ [DRSLV105]
@52014 = ~~ [DRSLV106]
@52015 = ~Наивысшая власть предначертана нам судьбой и нашим могуществом!~ [DRSOL101]
@52016 = ~К твоим услугам!~ [DRSOL102]
@52017 = ~За победу Паучьей Королевы!~ [DRSOL103]
@52018 = ~Лучшее наземное существо - мертвое наземное существо!~ [DRSOL104]
